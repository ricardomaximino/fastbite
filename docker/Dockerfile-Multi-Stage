# syntax=docker/dockerfile:1
FROM ghcr.io/graalvm/native-image-community:25 AS build
# The Maven wrapper unpacks Maven with unzip.
RUN microdnf install -y unzip findutils && microdnf clean all
WORKDIR /src
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY fastbite fastbite
COPY webapplication webapplication
RUN --mount=type=cache,target=/root/.m2 \
	sed -i 's/\r$//' mvnw && chmod +x mvnw \
	&& ./mvnw -B -q -DskipTests -pl webapplication -am install \
	&& ./mvnw -B -q -Pnative -DskipTests -pl webapplication native:compile \
	&& cp webapplication/target/webapplication /src/app \
	&& mkdir /src/storage

# Minimal non-root Linux runtime with glibc compatible with the GraalVM builder.
FROM gcr.io/distroless/base-debian13:nonroot
WORKDIR /app
COPY --from=build --chown=nonroot:nonroot /src/app /app/app
# Mount point for the shared file storage, owned by the user the service runs as.
COPY --from=build --chown=nonroot:nonroot /src/storage /storage
USER nonroot
EXPOSE 8080
ENTRYPOINT ["/app/app"]
